---
layout: base.njk
---
<article data-pagefind-body>
  <h1>{{ title }}</h1>
  <p class="text-muted"><time datetime="{{ page.date | isoDay }}">{{ page.date | readableDay }}</time></p>
  {%- if picture %}
  <img src="{{ picture }}" alt="{{ pictureAlt }}" width="{{ pictureWidth }}" height="{{ pictureHeight }}" class="rounded-lg ring-1 ring-white/10">
  {%- endif %}
  {{ content | safe }}
</article>
