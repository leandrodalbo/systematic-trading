{
  "name": "quant-research-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "css": "tailwindcss -i styles/site.css -o _site/styles/site.css --minify",
    "build": "eleventy && npm run css",
    "start": "npm run css -- --watch & eleventy --serve",
    "test": "eleventy --quiet && npm run css --silent && node --test",
    "deploy": "./deploy.sh"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "cheerio": "^1.2.0",
    "tailwindcss": "^4.3.5"
  }
}
